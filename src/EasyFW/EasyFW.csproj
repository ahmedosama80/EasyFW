<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>EasyFW</RootNamespace>
    <AssemblyName>EasyFW</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- A 32-bit process would see redirected System32 paths and write the wrong rule paths. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.1.0</Version>
    <Product>EasyFW</Product>
    <Description>Opt-in home firewall for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Data\**" />
    <!-- IP to Country Lite by DB-IP (CC BY 4.0). Kept beside the exe so it can be swapped for a newer month's file. -->
    <Content Include="Data\dbip-country-lite.csv.gz" Link="dbip-country-lite.csv.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- famfamfam flag icons by Mark James (public domain), as a sprite from legacy-icons/famfamfam-flags. -->
    <EmbeddedResource Include="Data\flags.png" LogicalName="EasyFW.flags.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>
